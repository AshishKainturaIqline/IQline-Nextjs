# Mailtrap Email Sandbox (uncomment for local capture testing).
# SMTP_EMAIL="noreply@iqline.co.in"
# SMTP_HOST="sandbox.smtp.mailtrap.io"
# SMTP_PASSWORD="your-mailtrap-password"
# SMTP_PORT="2525"
# SMTP_SECURE="false"
# SMTP_USERNAME="your-mailtrap-username"
# SMTP_FROM="IQ-Line Website <noreply@iqline.co.in>"

# Live SMTP (Office 365 example).
SMTP_EMAIL="noreply@iqline.co.in"
SMTP_HOST="smtp.office365.com"
SMTP_PASSWORD="your-mailbox-password"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME="noreply@iqline.co.in"
SMTP_FROM="IQ-Line Website <noreply@iqline.co.in>"

# Form recipients.
MAIL_TO_GENERAL=info@iqline.co.in
MAIL_TO_CAREERS=priyanka.singh@iqline.co.in

# MySQL for studio jobs and the public careers page.
# On the Hostinger server use 127.0.0.1. From a laptop use the remote hostname
# shown in hPanel after Remote MySQL access is allowed for your IP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Required. Signs the studio login cookie. At least 32 random characters.
# Set this in the hosting environment variables for production. Do not commit a real value.
# SESSION_SECRET=

# Optional: Google Search Console HTML tag verification (omit placeholder until you have a real code)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# Optional: Google Tag Manager container. GTM is not loaded when this is unset. Rebuild after changing it.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
